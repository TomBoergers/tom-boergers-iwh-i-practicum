doctype html
html(lang="en")
    head
        meta(charset="utf-8")
        meta(name="viewport" content="width=device-width, initial-scale=1")
        title= title
        link(rel="stylesheet", href="/css/style.css")
    body
        main
            a(href="/") Return to the homepage
            h1 Add a workshop
            p Create a workshop record in the HubSpot developer test account.
            if error
                p.error(role="alert")= error
            form(method="post", action="/update-cobj")
                label(for="name") Name
                input#name(type="text", name="name", value=values.name, maxlength="200", required)
                label(for="topic") Topic
                input#topic(type="text", name="topic", value=values.topic, maxlength="500", required)
                label(for="capacity") Capacity
                input#capacity(type="number", name="capacity", value=values.capacity, min="1", step="1", required)
                button(type="submit") Add workshop
